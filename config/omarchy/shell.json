{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "id": "ewse.workspaces"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "ewse.weather"
        },
        {
          "alwaysShow": true,
          "id": "ewse.indicators",
